native_include "sisl/utility/non_null_ptr.hpp";

namespace homeblkscfg;

attribute "hotswap";
attribute "deprecated";


table HomeBlksSettings{
    // reaper thread timer in seconds
    reaper_thread_timer_secs: uint64 = 120;

    // shutdown thread timer in seconds
    shutdown_thread_timer_secs: uint64 = 2;

    // fault containment feature on/off
    fault_containment_on: bool = true;

    // homestore index service chunk size;
    hs_index_chunk_size_mb: uint32 = 2048;

    // homestore dataservice chunk size;
    hs_data_chunk_size_mb: uint32 = 2048;

    // how often (in appended LSNs) the leader auto-proposes a SyncRSCommitLSN entry;
    sync_rs_commit_lsn_interval: uint32 = 128;

    // deadline (in milliseconds) for a server-to-server peer fetch_data() call;
    // a peer that misses it is treated as unreachable, same as a hard failure.
    peer_fetch_timeout_ms: uint32 = 5000;
}

root_type HomeBlksSettings;
