native_include "sisl/utility/non_null_ptr.hpp";

namespace homeblkscfg;

attribute "hotswap";
attribute "deprecated";


table HomeBlksSettings{
    // reaper thread timer in seconds
    reaper_thread_timer_secs: uint64 = 120;

    // shutdown thread timer in seconds
    shutdown_thread_timer_secs: uint64 = 2;

    // fault containment feature on/off
    fault_containment_on: bool = true;

    // homestore index service chunk size;
    hs_index_chunk_size_mb: uint32 = 2048;

    // homestore dataservice chunk size;
    hs_data_chunk_size_mb: uint32 = 2048;

    // lazy chunk allocator on/off
    dynamic_chunk_allocation: bool = true;

    // how often (in appended LSNs) the leader auto-proposes a SyncRSCommitLSN entry; also gates how
    // often a commit_lsn advance triggers a HomeStore checkpoint (SDSTOR-22888, CraftReplDev::
    // checkpoint_lsn_interval_), tying checkpoint cadence to this same periodic cadence;
    sync_rs_commit_lsn_interval: uint32 = 128;

    // deadline (in milliseconds) for a server-to-server peer fetch_data() call;
    // a peer that misses it is treated as unreachable, same as a hard failure.
    peer_fetch_timeout_ms: uint32 = 5000;

    // CRAFT client-liveness watchdog timeout in milliseconds -- reset on every successful write()/
    // keep_alive(); on expiry (no activity from the current session) proposes a SyncRSCommitLSN
    // entry via append() so the replica set can make progress without the client.
    // 0 = watchdog disabled.
    craft_watchdog_timeout_ms: uint64 = 30000;

    // Maximum byte length (in MiB) accepted for a single CRAFT write() or read() call. Requests
    // larger than this are rejected with invalid_argument -- both paths are reachable from the
    // client wire, so an unbounded len would allow a malformed frame to drive an unbounded index
    // range operation or a multi-GiB allocation.
    craft_max_io_len_mb: uint64 = 128;

    // CRAFT create_volume: how long (in milliseconds) the member that formed the RAFT group waits for the
    // volume's CreateVolume entry to commit and apply locally before it gives up and destroys the group.
    // Also bounds the wait for that destroy.
    craft_create_volume_timeout_ms: uint32 = 30000;

    // CRAFT: deadline (in milliseconds) for a RAFT proposal (SyncRSCommitLSN, InternalLogin) to commit. A proposal
    // that misses it completes with timed_out, but the entry may still commit later. 0 = no deadline.
    craft_raft_propose_timeout_ms: uint32 = 10000;

    // CRAFT: deadline (in milliseconds) for a journal write to complete. HomeStore never completes one whose device
    // write failed (SDSTOR-24993): it fails timed_out instead, and the partition faults, as the write may still land.
    // 0 = no deadline.
    craft_journal_write_timeout_ms: uint32 = 30000;

    // CRAFT: a member without a volume's replica hands the group's RAFT leadership off when elected, but not again
    // within this many milliseconds of its last hand-off: two such members would hand it to each other at once,
    // forever, while the member with the replica doesn't answer. It retries once the time is over.
    craft_leadership_handoff_backoff_ms: uint32 = 10000;

    // CRAFT snapshot (docs/craft/resync.md 4.9): the data one object carries at most (a batch holds at least one LBA),
    // and the size of a region, the unit a receiver resumes from after a restart. A region must fit in 32767 batches.
    craft_snapshot_batch_mb: uint32 = 16;
    // Whether a leader serves snapshots at all. Off, a member behind the log compaction stays behind until a partition
    // move replaces it.
    craft_snapshot_enabled: bool = true;
    craft_snapshot_region_mb: uint32 = 1024;
    // RetainFrom (resync.md 4.8): a pin a snapshot transfer holds on every member's journal is dropped by the member
    // once older than this many seconds, or once it keeps more than this many journal slots, so journal space is never
    // traded for a transfer (that transfer may then fail and start over). 0 = no limit.
    craft_retain_timeout_s: uint32 = 3600;
    craft_retain_max_slots: uint64 = 10000000;
}

root_type HomeBlksSettings;
